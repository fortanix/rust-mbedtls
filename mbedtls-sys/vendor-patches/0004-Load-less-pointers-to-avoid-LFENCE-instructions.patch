         for (i = bytes_to_copy; i < stored_bytes; i++) {
-            if (GET_BYTE(X, i) != 0) {
+            if (GET_BYTE(Xp, i) != 0) {
                 return MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL;
             }
         }
     }
 
     for (i = 0; i < bytes_to_copy; i++) {
-        buf[i] = GET_BYTE(X, i);
+        buf[i] = GET_BYTE(Xp, i);
     }
 
