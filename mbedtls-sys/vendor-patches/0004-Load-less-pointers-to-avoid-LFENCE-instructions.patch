             return X->s;
         }
-        if (X->p[i - 1] < Y->p[i - 1]) {
+        if (Xp[i - 1] < Yp[i - 1]) {
             return -X->s;
         }
     }
@@ -1253,8 +1265,9 @@ int mbedtls_mpi_sub_abs(mbedtls_mpi *X, const mbedtls_mpi *A, const mbedtls_mpi
