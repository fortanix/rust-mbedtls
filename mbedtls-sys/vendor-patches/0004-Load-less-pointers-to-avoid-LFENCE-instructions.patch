+#define GET_BYTE(Xp, i)                                \
+    (((Xp)[(i) / ciL] >> (((i) % ciL) * 8)) & 0xff)
 
 /*
  * Set a bit to a specific value of 0 or 1
@@ -336,9 +338,11 @@ size_t mbedtls_mpi_lsb(const mbedtls_mpi *X)
     size_t i, j, count = 0;
