+            if (((Xp[i] >> j) & 1) != 0) {
                 return count;
             }
         }
@@ -372,18 +376,19 @@ static size_t mbedtls_clz(const mbedtls_mpi_uint x)
 size_t mbedtls_mpi_bitlen(const mbedtls_mpi *X)
 {
     size_t i, j;
+    const mbedtls_mpi_uint *Xp = X->p;
 
     if (X->n == 0) {
         return 0;
     }
 
     for (i = X->n - 1; i > 0; i--) {
-        if (X->p[i] != 0) {
+        if (Xp[i] != 0) {
             break;
         }
     }
 
-    j = biL - mbedtls_clz(X->p[i]);
+    j = biL - mbedtls_clz(Xp[i]);
 
     return (i * biL) + j;
 }
