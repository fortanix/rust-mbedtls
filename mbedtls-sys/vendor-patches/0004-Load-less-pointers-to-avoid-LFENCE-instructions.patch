+    const mbedtls_mpi_uint *Xp = X->p;
 
     if (stored_bytes < buflen) {
         /* There is enough space in the output buffer. Write initial
@@ -924,14 +932,14 @@ int mbedtls_mpi_write_binary(const mbedtls_mpi *X,
